{
  "id": "community.base64-kit",
  "name": "Base64 / Data URI 编解码",
  "version": "0.2.0",
  "apiVersion": 1,
  "license": "MIT",
  "description": "文件与 Base64 / Data URI 互转：编码结果进剪贴板或写 .b64.txt，也能把 Base64 文本还原成文件。",
  "runtime": "process",
  "entry": "Base64Kit.exe",
  "permissions": ["fs.read", "fs.write", "clipboard.write"],
  "commands": [
    {
      "id": "community.base64-kit.encode",
      "title": "文件转 Base64 / Data URI",
      "description": "把选中文件编码成 data:<mime>;base64,... 或纯 Base64，结果进剪贴板，可选写 .b64.txt。",
      "group": "开发",
      "icon": "code-format",
      "order": 240,
      "autoRun": true,
      "selection": { "kind": "files", "min": 1, "max": 20 },
      "parameters": [
        {
          "key": "outputMode",
          "label": "编码格式",
          "type": "select",
          "default": "Data URI (含 MIME)",
          "options": ["Data URI (含 MIME)", "纯 Base64 字符串"]
        },
        {
          "key": "saveToFile",
          "label": "同时保存为 .b64.txt",
          "type": "toggle",
          "default": "false"
        },
        {
          "key": "outputFolder",
          "label": "输出文件夹（留空=原目录）",
          "type": "folder",
          "default": ""
        }
      ]
    },
    {
      "id": "community.base64-kit.decode",
      "title": "Base64 文本还原为文件",
      "description": "粘贴 Base64 或 Data URI，自动剥离前缀与空白并还原成文件。",
      "group": "开发",
      "icon": "file",
      "order": 241,
      "selection": { "kind": "any", "min": 1, "max": 1 },
      "parameters": [
        {
          "key": "payload",
          "label": "Base64 或 Data URI 内容",
          "type": "text",
          "default": "",
          "required": true,
          "hint": "支持 data:image/png;base64,... 前缀，空白与换行会被忽略。"
        },
        {
          "key": "extension",
          "label": "目标扩展名（留空自动识别）",
          "type": "text",
          "default": "",
          "hint": "无法从 Data URI 识别时输出 .bin。"
        },
        {
          "key": "outputFolder",
          "label": "输出文件夹（留空=选中项所在目录）",
          "type": "folder",
          "default": ""
        }
      ]
    }
  ]
}
