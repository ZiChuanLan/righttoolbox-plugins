{
  "id": "community.pdf-merge",
  "name": "PDF 合并 / 拆分 / 提取",
  "version": "0.1.0",
  "apiVersion": 1,
  "license": "MIT",
  "description": "把多个 PDF 合并成一个、把每个 PDF 按页拆成单页，或提取指定页码；扫描件、发票、合同的常见整理需求。",
  "runtime": "process",
  "entry": "PdfMerge.exe",
  "permissions": ["fs.read", "fs.write"],
  "commands": [
    {
      "id": "community.pdf-merge.apply",
      "title": "PDF 合并 / 拆分 / 提取",
      "description": "合并多个 PDF、按页拆分、或按 1-3,5 这样的页码范围提取。",
      "group": "文档",
      "icon": "layers",
      "order": 289,
      "selection": {
        "kind": "files",
        "min": 1,
        "max": 200,
        "extensions": [".pdf"]
      },
      "parameters": [
        {
          "key": "action",
          "label": "处理方式",
          "type": "select",
          "default": "合并为一个 PDF",
          "options": ["合并为一个 PDF", "每页拆成单独文件", "提取指定页码"]
        },
        {
          "key": "pages",
          "label": "页码范围",
          "type": "text",
          "default": "",
          "hint": "仅「提取指定页码」使用，例如 1-3,5；留空表示全部页。"
        },
        {
          "key": "outputFolder",
          "label": "输出文件夹（留空=原目录）",
          "type": "folder",
          "default": ""
        }
      ]
    }
  ]
}
