{
  "id": "community.clean-junk",
  "name": "清理垃圾文件与空文件夹",
  "version": "0.1.0",
  "apiVersion": 1,
  "license": "MIT",
  "description": "清理 Thumbs.db、.DS_Store、临时文件、0 字节文件与空文件夹，先预览确认再删除。",
  "runtime": "process",
  "entry": "CleanJunk.exe",
  "permissions": ["fs.read", "fs.write"],
  "commands": [
    {
      "id": "community.clean-junk.clean",
      "title": "清理垃圾文件与空文件夹",
      "description": "递归清理缩略图缓存、临时文件、空文件夹；先列出清单，确认后才删除。",
      "group": "文件",
      "icon": "trash-2",
      "order": 270,
      "requiresPreview": true,
      "cancellable": false,
      "selection": { "kind": "any", "min": 1, "max": 200 },
      "parameters": [
        {
          "key": "systemNoise",
          "label": "缩略图与系统垃圾（Thumbs.db、.DS_Store）",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "tempFiles",
          "label": "临时文件（.tmp / .temp / ~$ 开头的 Office 锁文件）",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "emptyDirectories",
          "label": "空文件夹",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "emptyFiles",
          "label": "0 字节文件（谨慎：可能是占位文件）",
          "type": "toggle",
          "default": "false"
        }
      ]
    }
  ]
}
