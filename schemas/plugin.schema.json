{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RightToolbox plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "license",
    "runtime",
    "commands"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "apiVersion": {
      "const": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "runtime": {
      "const": "process"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "fs.read",
          "fs.write",
          "clipboard.write",
          "network",
          "process.inspect",
          "process.spawn"
        ]
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "files",
            "folders",
            "any"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[a-zA-Z0-9]+$"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{2,79}$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "select",
            "toggle",
            "folder",
            "password"
          ]
        },
        "default": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]{0,40}$"
        },
        "order": {
          "type": "integer"
        },
        "requiresPreview": {
          "type": "boolean"
        },
        "livePreview": {
          "type": "boolean"
        },
        "autoRun": {
          "type": "boolean"
        },
        "cancellable": {
          "type": "boolean"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      }
    }
  }
}
